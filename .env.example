APP_ENV=development
AUTH_REQUIRED=false
LOCAL_DEMO_MODE=false

AUTH_DB_PATH=data/auth.sqlite3

# Required in production; supply privately through deployment secrets.
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>

# Comma-separated explicit origins. Never use *
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# For local anonymous demo mode only; bind Uvicorn to 127.0.0.1.
# LOCAL_DEMO_MODE=true
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081

AUTH_IDLE_SECONDS=28800
AUTH_ABSOLUTE_SECONDS=86400
INVITATION_SECONDS=604800

RESUME_MAX_UPLOAD_BYTES=10485760
RESUME_MAX_UPLOAD_TOTAL_BYTES=104857600
RESUME_MAX_UPLOAD_FILES=50
RESUME_MAX_ZIP_BYTES=52428800
RESUME_MAX_ZIP_ENTRIES=100
RESUME_MAX_ZIP_FILE_BYTES=10485760
RESUME_MAX_ZIP_TOTAL_BYTES=104857600
RESUME_MAX_ZIP_COMPRESSION_RATIO=100
